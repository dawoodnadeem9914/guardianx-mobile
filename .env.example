# =========================================================
# GuardianX Mobile — environment variables
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must never be committed.
# =========================================================

# --- Supabase (REAL — must be the SAME project as the GuardianX website) ---
# Powers: real "Connect to GuardianX" (real short-lived connection
# codes + real Supabase Auth sign-in), and — once connected — real
# Family Contacts (emergency_contacts) and real Medical Information
# (medical_profiles), reusing the website's existing tables directly.
# The anon key is safe for the browser by Supabase's own design; real
# security comes from RLS on the tables, not from hiding this value.
# Without these two set, the app is fully usable for Emergency Help —
# it just honestly shows "GuardianX connection isn't set up yet" on
# the Connect page, and Family Contacts / Medical Info stay on-device.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- OpenAI (server-only) ---
# Powers real emergency classification (medical/police/fire/unclear),
# real image analysis, and real context-aware AI guidance via
# GPT-4.1 mini — see src/app/api/ai/classify-emergency/route.ts and
# src/app/api/ai/emergency-guidance/route.ts. NEVER exposed to the
# browser. Without this, the app automatically falls back to a safe,
# clearly-non-AI-labeled deterministic classifier/guidance — nothing
# breaks or crashes.
OPENAI_API_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=https://guardianx-mobile.vercel.app
